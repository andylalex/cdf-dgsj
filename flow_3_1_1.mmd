flowchart TD
    A["导购在繁星APP生成带归因参数的分享链接<br/>g=导购ID · p=商品ID · s=分享ID"] --> B["顾客点击分享链接进入商品/下单页"]
    B --> B1["前端写入归因Token<br/>guideId + productId + shareId + 点击时间"]
    B1 --> C{"顾客操作路径"}

    C -->|"直接下单"| D1["订单行写入 attributed_guide"]
    D1 --> E1["计入该导购业绩<br/>场景1 · 导购链接直接下单"]

    C -->|"加入购物车"| D2["加购: 购物车行写入 attributed_guide"]
    D2 --> F["继续浏览 / 去结算"]
    F --> G["提交订单"]
    G --> E2["计入该导购业绩<br/>场景2 · 导购链接加购"]

    C -->|"未加购直接离开"| D3["Token 留存: 本机缓存 + 账号绑定<br/>归因窗口默认 15 天"]
    D3 --> H{"后续如何重回"}

    H -->|"从平台直接点击重回"| I1{"校验: 窗口内 + 同商品 + Token 有效?"}
    I1 -->|"命中"| J1["订单行写入 attributed_guide"]
    J1 --> E3a["计入该导购业绩<br/>场景3a · 平台点击重回"]
    I1 -->|"未命中"| K["归平台 · 无归因<br/>窗口过期 / 无Token / 纯自然流量"]

    H -->|"点击另一导购分享链接重回"| I2["刷新 Token: guideId 更新为<br/>最后一次点击的导购 Last-Touch"]
    I2 --> J2["下单: 订单行写入 attributed_guide = 最后点击导购"]
    J2 --> E3b["计入最后点击导购业绩<br/>场景3b · 另一导购链接重回"]
