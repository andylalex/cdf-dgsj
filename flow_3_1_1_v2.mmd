flowchart TD
    A["导购在繁星APP生成带归因参数的分享链接<br/>g=导购ID · p=商品ID · s=分享ID"] --> B["顾客点击分享链接进入商品/下单页"]
    B --> C{"顾客操作路径"}

    C -->|"直接下单(不走购物车)"| D1["归因 = 当前导购<br/>(本次下单所用分享链接的导购)"]
    D1 --> E1["计入该导购业绩<br/>场景1 · 导购链接直接下单"]

    C -->|"加入购物车"| D2["归因 = 1天内第一个导购<br/>(First-Touch, 窗口1天)"]
    D2 --> F["购物车行写入 attributed_guide = 首个导购"]
    F --> G["继续浏览 / 去结算"]
    G --> H["提交订单"]
    H --> E2["计入首个导购业绩<br/>场景2 · 导购链接加购"]

    C -->|"未加购直接离开"| D3["Token 留存: 本机缓存 + 账号绑定<br/>归因窗口默认 1 天"]
    D3 --> I{"后续如何重回"}

    I -->|"从平台直接点击重回并直接下单"| J1["归因 = 当前导购<br/>(沿用原分享链接导购, 窗口内)"]
    J1 --> E3a["计入原导购业绩<br/>场景3a · 平台点击重回"]

    I -->|"点击另一导购(新)链接"| I2{"操作方式?"}
    I2 -->|"直接用新链接购买"| J2["归因 = 新导购<br/>(本次下单所用链接导购)"]
    J2 --> E3b["计入新导购业绩<br/>场景3b · 新链接直接购买"]
    I2 -->|"用新链接加入购物车"| J3["归因仍 = 1天内第一个导购<br/>(加购按First-Touch, 新链接不改变)"]
    J3 --> E3c["计入首个导购业绩<br/>场景3c · 新链接加购仍归首导"]
